# Salin file ini:  cp env.example .env
# Lalu isi secret (lihat docs/00-docker-lokal.md atau scripts/gen-env.sh).
# Jangan commit .env — file itu berisi kata sandi.
#
# Jangan tulis PG_PASS= (kosong) di sini. Perintah openssl di bawah
# menambahkan baris baru; kalau sudah ada PG_PASS= kosong, Compose
# bisa memakai nilai kosong.

# Kata sandi Postgres. Wajib. Harus < 99 karakter.
# Isi dengan:  echo "PG_PASS=$(openssl rand -base64 36 | tr -d '\n')" >> .env

# Kunci rahasia Authentik (enkripsi sesi / token). Wajib, beda dari PG_PASS.
# Isi dengan:  echo "AUTHENTIK_SECRET_KEY=$(openssl rand -base64 60 | tr -d '\n')" >> .env

# Tag image Authentik. Default 2026.2.1 agar theme JS (light-DOM ak-brand-links)
# cocok. Boleh dinaikkan ke patch 2026.2.x yang lebih baru nanti.
AUTHENTIK_TAG=2026.2.1

# Port nginx di host. Hanya nginx yang dipublikasikan — jangan buka 9000/9443
# Authentik langsung, atau branding (suntik JS + /branding/) terlewati.
COMPOSE_PORT_HTTP=9000

# Matikan laporan error ke proyek Authentik.
AUTHENTIK_ERROR_REPORTING__ENABLED=false
